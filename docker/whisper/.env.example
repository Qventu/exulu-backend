# Copy to `.env` and fill in. `docker compose` reads this file automatically.

# ── Diarization (who spoke when) ────────────────────────────────────────────
# HuggingFace token — REQUIRED for speaker diarization.
#   1. Create a token (read scope is enough): https://huggingface.co/settings/tokens
#   2. While logged in, ACCEPT the licenses on BOTH gated model pages (one-time):
#        https://huggingface.co/pyannote/segmentation-3.0
#        https://huggingface.co/pyannote/speaker-diarization-3.1
# Without the token AND both licenses accepted, the server still transcribes,
# but every segment is labelled speaker="unknown".
HF_AUTH_TOKEN=

# ── Model / inference ───────────────────────────────────────────────────────
# Whisper model id. large-v3 is the most accurate (~3 GB download, wants ~10 GB
# VRAM). Smaller/faster alternatives: medium | small | base
WHISPER_MODEL=large-v3

# auto | cuda | cpu  — "auto" selects CUDA when a GPU is visible.
WHISPER_DEVICE=auto

# Inference batch size. Raise for more throughput if you have spare VRAM.
WHISPER_BATCH_SIZE=4

# ── Networking ──────────────────────────────────────────────────────────────
# Host port the server is published on (also used inside the container).
WHISPER_PORT=9876

# ── Host paths / build (optional) ───────────────────────────────────────────
# Where the HuggingFace cache lives ON THE HOST (bind-mounted into the
# container). Leave unset to use the invoking user's ~/.cache/huggingface.
# If you set it, use an ABSOLUTE path — e.g. /home/youruser/.cache/huggingface
# HF_CACHE_DIR=/home/youruser/.cache/huggingface

# Pin the @exulu/backend version for reproducible builds (default: latest).
# EXULU_VERSION=0.3.13
